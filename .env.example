# ZooLink MVP environment template. Copy to .env and fill real values. NEVER commit .env (see .gitignore).
# Provider choices follow ADR-0008 (RF-appropriate). All secrets are placeholders.

# ---- App ----
NODE_ENV=production
PORT=3000
PUBLIC_DOMAIN=zoolink.example.ru          # used by Caddy for automatic TLS
# Master-key DEV-ONLY /auth/dev-token route. Fail-closed: default false; only ever set true in
# local dev/test, NEVER in production (production hard-disables it regardless). Strict: only true/false.
ENABLE_DEV_TOKEN=false
# CORS allowlist — comma-separated EXACT browser origins allowed to call the API cross-origin (with
# credentials, for the refresh cookie). EMPTY in production: the SPA is same-origin behind Caddy
# (ADR-0009), so no CORS is needed. Set ONLY for cross-origin local dev, e.g. a SPA dev-server:
#   CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=

# ---- PostgreSQL ----
POSTGRES_USER=zoolink
POSTGRES_PASSWORD=__change_me__
POSTGRES_DB=zoolink
# App connection string (host = compose service name).
# RF RESIDENCY (ADR-0017 п.1, ФЗ-152 ст.18 ч.5) — THE HEAVIEST RULE IN THIS FILE: this is the PRIMARY
# store of personal data (accounts, phone_hash, encrypted email/contact_phone per ADR-0012, listings,
# consents, the moderation audit trail), so ФЗ-152 ст.18 ч.5 requires it to sit on RF territory. The
# HOST must be self-hosted (postgres:5432 — a compose service name / localhost / a private address /
# a unix socket via ?host=/var/run/postgresql) or under an RF domain (.ru/.su/.рф). A managed foreign
# database — e.g. postgresql://…@ep-x.us-east-2.aws.neon.tech/db, an AWS RDS or a Supabase endpoint —
# is FORBIDDEN: the API refuses to start (boot validator) and the CI gate
# scripts/check-rf-residency.sh fails. Measured 2026-08-09: before that gate existed, exactly such a
# line was accepted at NODE_ENV=production with every other residency layer reporting green. In
# production the RESIDENCY_ALLOW_NON_RF_DEV bypass is IGNORED. Adopting a MANAGED RF database (e.g.
# Yandex Managed PostgreSQL at *.mdb.yandexcloud.net, which no RF-suffix rule can see) is a CODE
# change in env.validation.ts through the ADR/security gate — never an edit to this line.
DATABASE_URL=postgresql://zoolink:__change_me__@postgres:5432/zoolink?schema=public

# ---- Redis ----
REDIS_PASSWORD=__change_me__
# RF RESIDENCY (ADR-0017 п.1) applies here TOO, and for the same reason: Redis is not "just a cache".
# It holds the rate-limit/throttler counters keyed by phone/IP, the per-user listing-creation quota and
# cached profile/listing payloads — personal data derived from the primary store. Self-hosted
# (redis:6379 / localhost / a private address) or an RF domain only; a managed foreign cache — e.g.
# rediss://…@eu2-x.upstash.io:6379 — is FORBIDDEN and rejected at boot and in CI.
REDIS_URL=redis://:__change_me__@redis:6379

# ---- Object storage (S3-compatible: MinIO dev / Yandex Object Storage prod) ----
# RF RESIDENCY (ADR-0017 п.4, ФЗ-152 ст.18 ч.5): the bucket holds PERSONAL DATA (provider documents,
# avatars, listing photos), so the endpoint HOST must be self-hosted (http://minio:9000 — a compose
# service name / localhost / a private address) or an approved RF store: an RF domain (.ru/.su/.рф) or
# https://storage.yandexcloud.net (ADR-0008). A foreign bucket — e.g.
# https://s3.us-west-004.backblazeb2.com or https://s3.amazonaws.com — is FORBIDDEN and is rejected at
# boot (the API refuses to start) and by the CI gate scripts/check-rf-residency.sh. NOTE: pinning
# S3_REGION to an RF id below does NOT make a foreign endpoint lawful — the region string and the host
# are independent, and this is the hole that stood open until 2026-08-09. The form must be
# http(s)://host[:port]; in production the RESIDENCY_ALLOW_NON_RF_DEV bypass is ignored.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=__change_me__
S3_SECRET_KEY=__change_me__
S3_BUCKET=zoolink-media
# Optional prod CDN host in front of the bucket. When set, its host is added to the media-URL
# allowlist alongside the S3 host so CDN-served listing photos pass the own-storage check. HOST only
# (no scheme/path), e.g. cdn.zoolink.ru. Leave empty in dev (S3 host is the sole allowed origin).
# RF RESIDENCY (ADR-0017 п.4): because this host is ADDED to the media allowlist, a foreign CDN would
# cache and serve avatars (personal data) from outside the RF — so a non-RF CDN (cdn.cloudflare.com,
# *.cloudfront.net, *.b-cdn.net) is FORBIDDEN and boot-blocking. Same allowed set as S3_ENDPOINT
# above. EMPTY = no CDN, which is the lawful default and needs no action.
MEDIA_CDN_HOST=
# RF data residency (ADR-0017, ФЗ-152 ст.18 ч.5): S3_REGION — like every *_REGION var — MUST be an
# approved RF region (RF_ALLOWED_REGIONS in env.validation.ts: ru-central1[-a/b/c/d]). A non-RF value
# throws at boot. NOTE: self-hosted MinIO defaults its region to us-east-1 — keep it pinned to an RF id.
S3_REGION=ru-central1
# Dev-only escape hatch: allow a NON-RF *_REGION (e.g. a MinIO left at us-east-1) — ONLY when
# NODE_ENV!=='production'. Ignored (and CI-blocked) in prod. Leave 'false' unless you know you need it.
RESIDENCY_ALLOW_NON_RF_DEV=false

# ---- Auth / JWT (ADR-0001, security_specification.md) ----
JWT_ACCESS_SECRET=__change_me__generate_a_32+_char_random_secret__
JWT_REFRESH_SECRET=__change_me__generate_another_32+_char_secret__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PHONE_HASH_PEPPER=__change_me__generate_a_32+_char_secret_pepper__
# ---- PII-at-rest crypto seam (ADR-0019 / ADR-0012) ----
# AES-256-GCM data key source (field-encrypts email/contact_phone) + HMAC key for the email blind index.
# No defaults (boot-blocking, like the JWT secrets). Rotating PII_DATA_KEY needs a re-encrypt migration;
# rotating PII_BLIND_INDEX_KEY needs an email_bidx backfill.
PII_DATA_KEY=__change_me__generate_a_32+_char_random_secret__
PII_BLIND_INDEX_KEY=__change_me__generate_another_32+_char_secret__
# Agent service-auth signing secret (ADR-0011 §5.2). FORM ONLY in MVP — the AGENT gate is off, so no
# agent service token is issued/verified. Optional in dev/test; REQUIRED (>=32 chars) in production.
AGENT_SERVICE_SIGNING_SECRET=__change_me__generate_a_32+_char_agent_signing_secret__

# ---- SMS (SMS.RU — ADR-0008) ----
SMS_PROVIDER=smsru
SMSRU_API_ID=__change_me__
SMS_FROM=                                  # optional approved sender name; empty = SMS.RU default

# ---- Email (Unisender — ADR-0008) ----
EMAIL_PROVIDER=unisender
UNISENDER_API_KEY=__change_me__
UNISENDER_LIST_ID=                         # list id used for the unsubscribe footer
EMAIL_FROM=noreply@zoolink.example.ru      # verified sender address (required for real send)
EMAIL_FROM_NAME=ZooLink

# --- Канал сообщений: MAX Bot API (ADR-0008, слово владельца 13.08.2026) ---
# Без токена фабрика берёт ЗАГЛУШКУ и канал спит — это законный дефолт, ничего не падает.
# ⚠️ РАЗРЕШЁННЫЙ ХОСТ ≠ РАБОТАЮЩИЙ КАНАЛ: домен MAX подписан сертификатом НУЦ Минцифры, которого
# нет в хранилище доверия по умолчанию. Включая канал, задайте рантайму российский корень:
#   NODE_EXTRA_CA_CERTS=/etc/ssl/certs/russian_trusted_ca.pem
# Иначе TLS упадёт — адаптер назовёт это причиной прямо, а не «сетью».
MESSENGER_PROVIDER=max
MAX_BOT_TOKEN=
# Хост зашит в адаптере и внесён в RF_ALLOWED_PROVIDER_HOSTS: зарубежный адрес дверь не пропустит.

# ---- Maps (Yandex.Maps — ADR-0008) ----
YANDEX_MAPS_API_KEY=__change_me__

# ---- OAuth ----
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
# Sign in with Apple (D3 / OPS-11) — adapter deferred, env FORM only. All four are required together
# for a real prod Apple integration (enforced at boot); leave all empty to keep Apple OAuth off.
# OAUTH_APPLE_PRIVATE_KEY holds the .p8 contents (mount as a secret file, read into env — no key in repo).
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=
OAUTH_TELEGRAM_BOT_TOKEN=
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=

# ---- Retention job (D2, worker-only — auto-expire listings + erase_user after grace) ----
# Cron for the periodic tick (default hourly). Read at decorator-eval time, so a deploy-time constant.
RETENTION_TICK_CRON=0 * * * *
# Deactivation grace (days) before erase_user runs (spec 01 / data-governance.md — 30-day default).
RETENTION_GRACE_DAYS=30

# Listing-creation quota (AUDIT4 P1-4): max NEW listings per user per rolling 24h (int > 0).
LISTING_CREATION_QUOTA_PER_DAY=20

# ---- Payments (Фаза 2+, gated by feature_toggles.payments — ЮKassa, ADR-0008) ----
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ---- Observability ----
# /metrics scrape credential. REQUIRED in production (≥16 chars) — without it MetricsGuard trusts the
# source IP, which behind the reverse proxy makes /metrics world-readable. Optional in dev/test (the
# guard's internal-client fallback covers local scraping). Present it as `Authorization: Bearer <token>`
# or `X-Metrics-Token: <token>` on the scrape. Read straight from process.env by MetricsGuard.
METRICS_TOKEN=
# Error-sink DSN. EMPTY = error reporting OFF (the MVP default — permitted, nothing is sent anywhere).
# RF RESIDENCY (ADR-0017 п.6, ФЗ-152 ст.18 ч.5): if you set it, the ingest HOST must be self-hosted
# (localhost / private address / a compose service name like http://sentry:9000) or under an RF domain
# (.ru/.su/.рф). A foreign SaaS ingest — e.g. https://<key>@o0.ingest.sentry.io/1 — is FORBIDDEN:
# stack traces carry PII, so that DSN exports РФ-citizen personal data across the border. It is
# rejected at boot (the API refuses to start) and by the CI gate scripts/check-rf-residency.sh; in
# production the RESIDENCY_ALLOW_NON_RF_DEV bypass is ignored.
SENTRY_DSN=
# Pino log level: fatal|error|warn|info|debug|trace (default info). Validated by env.validation.ts.
LOG_LEVEL=info
